{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isoroute",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "isoroute-db",
      "database_id": "7b5446c0-5080-4451-84a2-19079d83cc7d"
    }
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "region": "aws:us-east-1"
  }
}
